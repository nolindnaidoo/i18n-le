		"name": "the library is required and cannot be guessed",
		"arguments": {
			"files": [
				{
					"path": "en.json",
					"content": "{}"
				}
			]
		},
		"expectedError": "library is required and must be one of i18next, next-intl, vscode-l10n, flutter-arb. It cannot be worked out from file contents alone, and guessing it is what this tool exists not to do."
	},
	{
		"name": "a library this does not read is refused",
		"arguments": {
			"library": "gettext",
			"files": [
				{
					"path": "en.json",
					"content": "{}"
				}
			]
		},
		"expectedError": "gettext is not a library this reads. Try one of i18next, next-intl, vscode-l10n, flutter-arb."
	},
	{
		"name": "files are required",
		"arguments": {
			"library": "i18next"
		},
		"expectedError": "files is required and must be a non-empty array of { path, content }"
	},
	{
		"name": "an empty list is refused",
		"arguments": {
			"library": "i18next",
			"files": []
		},
		"expectedError": "files is required and must be a non-empty array of { path, content }"
	},
	{
		"name": "a locale that is not a language tag is refused",
		"arguments": {
			"library": "i18next",
			"files": [
				{
					"path": "en.json",
					"locale": "Spanish",
					"content": "{}"
				}
			]
		},
		"expectedError": "Spanish is not a language tag"
	},
	{
		"name": "a set that is not a catalogue set is refused rather than audited",
		"arguments": {
			"library": "i18next",
			"files": [
				{
					"path": "package.json",
					"content": "{}"
				},
				{
					"path": "tsconfig.json",
					"content": "{}"
				}
			]
		},
		"expectedError": "package.json: \"package\" is not a language tag, so this is not a catalogue set"
	}
]
